# Konsistente Zeilenenden: alle Textdateien als LF speichern UND auschecken.
# Wichtig, weil der Build/CI auf Linux läuft und scripts/backup-oldsite.sh +
# die .mjs/.yml-Dateien LF brauchen — sonst brechen Shell/CI unter Windows-CRLF.
* text=auto eol=lf

